# API key de Meteocat (Servei Meteorològic de Catalunya).
# Obtén-la registrant-te a https://apidocs.meteocat.gencat.cat/
# Copia aquest fitxer a .env.local i omple els valors (.env.local no es puja al repo).
METEOCAT_API_KEY=

# API key de N2YO (seguiment de satèl·lits).
# Obtén-la registrant-te a https://www.n2yo.com/api/
N2YO_API_KEY=
